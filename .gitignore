!.yarn/patches
!.yarn/releases
!.yarn/plugins

# Build output
dist/
build/
out/
*.tsbuildinfo
.next/
.turbo/
.rollup.cache/
.vite/

# Native mobile build output
DerivedData/
*.xcuserstate
xcuserdata/
Pods/
.gradle/
local.properties
*.iml

# Test & coverage
coverage/
.nyc_output/
test-results/
playwright-report/
