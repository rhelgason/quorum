# Local ingest service log — real user feedback, never commit it
data/*.jsonl

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*
