{
  "name": "quorum",
  "private": true,
  "version": "0.0.0",
  "description": "A drop-in feedback layer for any app — capture what users want, cluster it, and hand engineering a spec.",
  "license": "MIT",
  "author": "Ryan Helgason",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test 'packages/*/src/**/*.test.ts' 'services/*/src/**/*.test.ts' 'tools/*/src/**/*.test.ts' 'examples/*/*.test.ts'",
    "test:watch": "node --test --watch 'packages/*/src/**/*.test.ts' 'services/*/src/**/*.test.ts' 'tools/*/src/**/*.test.ts' 'examples/*/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='**/cli.ts' --test-coverage-exclude='**/nub.ts' --test-coverage-exclude='**/browser.ts' --test-coverage-exclude='**/*.browser.test.ts' --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 'packages/*/src/**/*.test.ts' 'services/*/src/**/*.test.ts' 'tools/*/src/**/*.test.ts' 'examples/*/*.test.ts'",
    "test:browser": "QUORUM_BROWSER_REQUIRED=1 node --test 'packages/web/src/nub.browser.test.ts'",
    "eval": "node packages/eval/src/cli.ts",
    "mock-model": "node packages/eval/src/mock-model.ts",
    "demo": "node examples/support-inbox/demo.ts",
    "serve": "node services/api/src/cli.ts",
    "app": "node examples/saas-app/start.ts",
    "northwind": "node examples/northwind/report.ts",
    "northwind:generate": "node examples/northwind/generate.ts",
    "lint": "npm run lint --workspaces --if-present",
    "size": "node tools/size/src/cli.ts",
    "check": "npm run typecheck && npm run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
